---
import Base from '../../layouts/Base.astro';
import mypageData from '../../data/mypage-user-sample.json';

const { userContext, profile, favorites, reservationHistory, notificationPreference, membershipHistory, pointHistory, reportsSubmitted, securitySettings } = mypageData;

const statusLabel = (s: string) => ({
  confirmed: '確定済',
  completed: '完了',
  cancelled: 'キャンセル',
  pending_shop_approval: '店舗承認待ち',
  auto_expired: '期限切れ'
}[s] ?? s);

const statusColor = (s: string) => ({
  confirmed: 'background: #eef3f8; color: #245;',
  completed: 'background: #e5f3e5; color: #363;',
  cancelled: 'background: #f5f5f5; color: #888;'
}[s] ?? 'background: #f5f5f5; color: #666;');
---

<Base title="mypage (skeleton) — rei-job-board" description="v0.7 Phase 4 user mypage skeleton — 店舗利用者側 sample data + auth 本体は Phase 6">
  <div style="padding: 12px 16px;">
    <div class="honest-banner">
      <strong>Layer 3 UI v0.7 Phase 4 — mypage SKELETON</strong>: 本 page は 未 login の 状態で 表示された sample mypage です。 <strong>auth 本体 / real user data / DB persistence / 個情法 開示請求 flow</strong> は Phase 6 (弁護士 consultation 後) の 別段階。 本 mypage は <strong>店舗利用者 (customer) 側</strong> の想定 skeleton = <strong>求職者 (job-seeker) mypage ではない</strong> (求職者情報 非収集 line は 本サイト main policy として維持、 footer 明記)。
    </div>

    <section style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin: 12px 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
      <div>
        <h1 style="font-size: 1.2rem; margin: 0;">こんにちは、 {userContext.displayName} さん</h1>
        <p style="margin: 4px 0; font-size: 0.85rem; color: #666;">
          tier: <code>{userContext.membershipTier}</code> · points: <strong>{userContext.pointsBalance.toLocaleString()}</strong> pt · 登録日: {userContext.joinedAt}
        </p>
        <p style="margin: 4px 0; font-size: 0.8rem; color: var(--warn);">
          ※ {userContext.loginNote}
        </p>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 0.85rem; color: #666;">お気に入り店舗</div>
        <div style="font-size: 1.4rem; font-weight: bold; color: var(--accent);">{favorites.length}</div>
      </div>
    </section>

    <nav id="tabs" style="display: flex; gap: 4px; border-bottom: 2px solid var(--border); margin: 16px 0 0 0; overflow-x: auto;">
      <button type="button" class="tab-btn is-active" data-tab="profile" style="padding: 8px 14px; background: none; border: none; cursor: pointer; font-size: 0.9rem; border-bottom: 2px solid transparent;">プロフィール</button>
      <button type="button" class="tab-btn" data-tab="favorites" style="padding: 8px 14px; background: none; border: none; cursor: pointer; font-size: 0.9rem; border-bottom: 2px solid transparent;">お気に入り ({favorites.length})</button>
      <button type="button" class="tab-btn" data-tab="reservations" style="padding: 8px 14px; background: none; border: none; cursor: pointer; font-size: 0.9rem; border-bottom: 2px solid transparent;">予約履歴 ({reservationHistory.length})</button>
      <button type="button" class="tab-btn" data-tab="notifications" style="padding: 8px 14px; background: none; border: none; cursor: pointer; font-size: 0.9rem; border-bottom: 2px solid transparent;">通知設定</button>
      <button type="button" class="tab-btn" data-tab="points" style="padding: 8px 14px; background: none; border: none; cursor: pointer; font-size: 0.9rem; border-bottom: 2px solid transparent;">point ({pointHistory.length})</button>
      <button type="button" class="tab-btn" data-tab="reports" style="padding: 8px 14px; background: none; border: none; cursor: pointer; font-size: 0.9rem; border-bottom: 2px solid transparent;">通報履歴 ({reportsSubmitted.length})</button>
      <button type="button" class="tab-btn" data-tab="security" style="padding: 8px 14px; background: none; border: none; cursor: pointer; font-size: 0.9rem; border-bottom: 2px solid transparent;">セキュリティ</button>
    </nav>

    <section id="tab-profile" class="tab-panel" style="padding: 16px 0;">
      <h2 style="font-size: 1.05rem; margin: 0 0 12px 0;">プロフィール</h2>
      <table style="width: 100%; background: #fff; border: 1px solid var(--border); border-radius: 6px; border-collapse: separate; border-spacing: 0;">
        <tbody>
          <tr>
            <th style="text-align: left; padding: 10px 14px; background: #f8f8f8; width: 180px;">表示名</th>
            <td style="padding: 10px 14px;">{profile.displayName}</td>
          </tr>
          <tr style="border-top: 1px solid var(--border);">
            <th style="text-align: left; padding: 10px 14px; background: #f8f8f8;">email</th>
            <td style="padding: 10px 14px;">{profile.email}</td>
          </tr>
          <tr style="border-top: 1px solid var(--border);">
            <th style="text-align: left; padding: 10px 14px; background: #f8f8f8;">興味エリア</th>
            <td style="padding: 10px 14px;">{profile.prefectureOfInterest} · {profile.nearestStation}</td>
          </tr>
          <tr style="border-top: 1px solid var(--border);">
            <th style="text-align: left; padding: 10px 14px; background: #f8f8f8;">言語</th>
            <td style="padding: 10px 14px;"><code>{profile.language}</code></td>
          </tr>
          <tr style="border-top: 1px solid var(--border);">
            <th style="text-align: left; padding: 10px 14px; background: #f8f8f8;">tier</th>
            <td style="padding: 10px 14px;">
              <span style="background: #eef3f8; color: #245; padding: 2px 8px; border-radius: 3px; font-size: 0.85rem;">{userContext.membershipTier}</span>
              <span style="margin-left: 8px; font-size: 0.8rem; color: #666;">(内訳は 履歴 tab)</span>
            </td>
          </tr>
        </tbody>
      </table>
      <div style="margin-top: 12px; display: flex; gap: 6px;">
        <button type="button" disabled style="padding: 4px 12px; font-size: 0.85rem; background: #eee; border: 1px solid var(--border); border-radius: 3px; cursor: not-allowed;">プロフィール編集 (Phase 6)</button>
        <button type="button" disabled style="padding: 4px 12px; font-size: 0.85rem; background: #eee; border: 1px solid var(--border); border-radius: 3px; cursor: not-allowed;">password 変更 (Phase 6)</button>
        <button type="button" disabled style="padding: 4px 12px; font-size: 0.85rem; background: #fff5f5; color: var(--warn); border: 1px solid var(--warn); border-radius: 3px; cursor: not-allowed;">退会 (Phase 6, 個情法 削除請求)</button>
      </div>
      <p style="font-size: 0.8rem; color: #666; margin-top: 8px;">※ profile 変更は 個情法 audit log 記録が Phase 6 で 必須。 skeleton は 表示のみ。</p>
    </section>

    <section id="tab-favorites" class="tab-panel" style="padding: 16px 0; display: none;">
      <h2 style="font-size: 1.05rem; margin: 0 0 12px 0;">お気に入り 店舗</h2>
      <ul style="list-style: none; padding: 0;">
        {favorites.map(f => (
          <li style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div>
              <div style="font-size: 1rem;">
                <a href={`/shops/${f.shopId}`} style="color: var(--accent); text-decoration: none;">{f.shopName}</a>
              </div>
              <div style="font-size: 0.8rem; color: #666;">追加: {f.addedAt}</div>
            </div>
            <div style="display: flex; gap: 6px; align-items: center;">
              <label style="font-size: 0.85rem;">
                <input type="checkbox" checked={f.notifyOnNewCoupon} disabled /> 新クーポン通知
              </label>
              <button type="button" disabled style="padding: 4px 10px; font-size: 0.8rem; background: #eee; border: 1px solid var(--border); border-radius: 3px; cursor: not-allowed;">解除 (Phase 6)</button>
            </div>
          </li>
        ))}
      </ul>
      <p style="font-size: 0.8rem; color: #666;">※ お気に入り 追加/解除 の persistence は Phase 6。 skeleton は sample 表示のみ。</p>
    </section>

    <section id="tab-reservations" class="tab-panel" style="padding: 16px 0; display: none;">
      <h2 style="font-size: 1.05rem; margin: 0 0 12px 0;">予約 履歴</h2>
      <ul style="list-style: none; padding: 0;">
        {reservationHistory.map(r => (
          <li style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin-bottom: 8px;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
              <div>
                <a href={`/shops/${r.shopId}`} style="color: var(--accent); text-decoration: none; font-weight: bold;">{r.shopName}</a>
                <div style="font-size: 0.85rem; color: #666; margin-top: 2px;">
                  {r.reservationDate} {r.reservationStartTime} · {r.durationMinutes} 分
                </div>
              </div>
              <span style={`padding: 3px 10px; border-radius: 3px; font-size: 0.8rem; ${statusColor(r.status)}`}>
                {statusLabel(r.status)}
              </span>
            </div>
            <div style="margin-top: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
              <span style="font-size: 0.85rem;">
                {r.totalPriceYen > 0 ? '¥' + r.totalPriceYen.toLocaleString() : '-'}
                {'cancellationFeeYen' in r && r.cancellationFeeYen === 0 && r.status === 'cancelled' && (
                  <span style="color: #666; margin-left: 8px; font-size: 0.8rem;">(キャンセル料 なし)</span>
                )}
              </span>
              <div style="display: flex; gap: 6px;">
                {r.canModify && (
                  <button type="button" disabled style="padding: 3px 10px; font-size: 0.8rem; background: #eee; border: 1px solid var(--border); border-radius: 3px; cursor: not-allowed;">変更 (Phase 6)</button>
                )}
                {r.canCancel && (
                  <button type="button" disabled style="padding: 3px 10px; font-size: 0.8rem; background: #fff5f5; color: var(--warn); border: 1px solid var(--warn); border-radius: 3px; cursor: not-allowed;">キャンセル (Phase 6)</button>
                )}
                {r.status === 'completed' && !('hasReviewed' in r ? r.hasReviewed : false) && (
                  <button type="button" disabled style="padding: 3px 10px; font-size: 0.8rem; background: #eee; border: 1px solid var(--border); border-radius: 3px; cursor: not-allowed;">口コミ投稿 (Phase 6)</button>
                )}
              </div>
            </div>
            {'cancellationReason' in r && r.cancellationReason && (
              <p style="margin: 6px 0 0 0; font-size: 0.8rem; color: #666;">理由: {r.cancellationReason}</p>
            )}
          </li>
        ))}
      </ul>
      <p style="font-size: 0.8rem; color: #666;">※ 予約 変更/キャンセル workflow は 消費者契約法 対応 で Phase 6 実装 (キャンセル料 事前明示 前提)。 skeleton は 履歴 表示のみ。</p>
    </section>

    <section id="tab-notifications" class="tab-panel" style="padding: 16px 0; display: none;">
      <h2 style="font-size: 1.05rem; margin: 0 0 12px 0;">通知 preference</h2>
      <div style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 14px;">
        <h3 style="font-size: 0.95rem; margin: 0 0 8px 0;">Email 通知</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 4px;">
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.emailNewShopArrival} disabled /> 新店舗 通知</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.emailReservationReminder} disabled /> 予約リマインダ</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.emailReviewResponse} disabled /> 口コミ返信</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.emailPointExpiryWarning} disabled /> point 期限</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.emailWeeklyRanking} disabled /> 週間 ランキング</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.emailFeaturedArticle} disabled /> 特集 記事</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.emailMarketingCampaign} disabled /> マーケティング campaign</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.emailPromotionalCoupon} disabled /> クーポン</label>
        </div>

        <h3 style="font-size: 0.95rem; margin: 14px 0 8px 0;">Push / LINE</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 4px;">
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.pushEnabled} disabled /> Push 全般</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.pushReservationReminder} disabled /> 予約リマインダ (push)</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.pushFavoritePerformerDiary} disabled /> お気に入り 日記 (push)</label>
          <label style="font-size: 0.85rem;"><input type="checkbox" checked={notificationPreference.lineNotifyEnabled} disabled /> LINE Notify</label>
        </div>

        <h3 style="font-size: 0.95rem; margin: 14px 0 8px 0;">頻度制限 / quiet hours</h3>
        <p style="font-size: 0.85rem; margin: 4px 0;">
          頻度: <code>{notificationPreference.emailFrequencyLimit}</code>
          · quiet hours: {notificationPreference.quietHoursStart} 〜 {notificationPreference.quietHoursEnd}
        </p>
      </div>
      <p style="font-size: 0.8rem; color: #666; margin-top: 8px;">※ granular opt-in/opt-out は 個情法 「利用目的変更の同意撤回権利」 対応で Phase 6 実装。 skeleton は 現在設定 表示のみ (checkbox 全 disabled)。</p>
    </section>

    <section id="tab-points" class="tab-panel" style="padding: 16px 0; display: none;">
      <h2 style="font-size: 1.05rem; margin: 0 0 12px 0;">point / membership</h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-bottom: 16px;">
        <div style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px;">
          <div style="font-size: 0.8rem; color: #666;">現在 point</div>
          <div style="font-size: 1.6rem; font-weight: bold; color: var(--accent);">{userContext.pointsBalance.toLocaleString()} pt</div>
        </div>
        <div style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px;">
          <div style="font-size: 0.8rem; color: #666;">現在 tier</div>
          <div style="font-size: 1.6rem; font-weight: bold; color: var(--accent);">{userContext.membershipTier}</div>
        </div>
      </div>

      <h3 style="font-size: 0.95rem; margin: 12px 0 6px 0;">membership tier 履歴</h3>
      <ul style="list-style: none; padding: 0;">
        {membershipHistory.map(m => (
          <li style="background: #fff; border: 1px solid var(--border); border-radius: 4px; padding: 8px 12px; margin-bottom: 4px; font-size: 0.9rem;">
            {m.changedAt}: {m.oldTier ?? '(新規)'} → <strong>{m.newTier}</strong>
            <span style="color: #666; font-size: 0.8rem; margin-left: 8px;">({m.changeReason})</span>
          </li>
        ))}
      </ul>

      <h3 style="font-size: 0.95rem; margin: 12px 0 6px 0;">point 交換 履歴</h3>
      <ul style="list-style: none; padding: 0;">
        {pointHistory.map(p => (
          <li style="background: #fff; border: 1px solid var(--border); border-radius: 4px; padding: 8px 12px; margin-bottom: 4px; font-size: 0.9rem;">
            <div>{p.redeemedAt}: <strong>-{p.pointsUsed} pt</strong> · 相当額 ¥{p.redemptionValueYen?.toLocaleString() ?? '-'}</div>
            <div style="font-size: 0.8rem; color: #666;">{p.redemptionType} · {p.note}</div>
          </li>
        ))}
      </ul>
      <p style="font-size: 0.8rem; color: #666; margin-top: 8px;">※ point 交換 flow は 特定商取引法 該当性検討 (Phase 6, 弁護士 consultation)。 skeleton は 履歴 表示のみ。</p>
    </section>

    <section id="tab-reports" class="tab-panel" style="padding: 16px 0; display: none;">
      <h2 style="font-size: 1.05rem; margin: 0 0 12px 0;">通報 送信 履歴</h2>
      {reportsSubmitted.length === 0 ? (
        <p style="background: #e5f3e5; color: #363; padding: 12px; border-radius: 4px; font-size: 0.9rem;">
          送信 履歴 は ありません。
        </p>
      ) : (
        <ul style="list-style: none; padding: 0;">
          {reportsSubmitted.map(r => (
            <li style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin-bottom: 8px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px;">
                <span style="font-weight: bold; font-size: 0.95rem;">{r.reportCategory}</span>
                <span style="background: #fff4e5; color: #a52; padding: 2px 8px; border-radius: 3px; font-size: 0.75rem;">{r.currentStatus}</span>
              </div>
              <p style="margin: 6px 0; font-size: 0.9rem;">{r.description}</p>
              <div style="font-size: 0.8rem; color: #666;">
                提出: {r.submittedAt} · target: <code>{r.targetType}/{r.targetId}</code>
              </div>
              {r.adminResponseNotes && (
                <p style="margin: 8px 0 0 0; padding: 6px 10px; background: #f8f8f8; border-left: 3px solid var(--accent); font-size: 0.85rem;">
                  admin: {r.adminResponseNotes}
                </p>
              )}
            </li>
          ))}
        </ul>
      )}
      <p style="font-size: 0.8rem; color: #666; margin-top: 8px;">※ プロバイダ責任制限法 対応 通報 workflow は Phase 6 実装 (admin-schema Report と連動)。 skeleton は 履歴 表示のみ。</p>
    </section>

    <section id="tab-security" class="tab-panel" style="padding: 16px 0; display: none;">
      <h2 style="font-size: 1.05rem; margin: 0 0 12px 0;">セキュリティ</h2>

      <div style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin-bottom: 12px;">
        <h3 style="font-size: 0.95rem; margin: 0 0 8px 0;">MFA 設定</h3>
        <p style="font-size: 0.9rem; margin: 4px 0;">
          MFA: {securitySettings.mfaEnabled ? '有効' : <span style="color: var(--warn);">無効 (推奨: 有効化)</span>}
        </p>
        <button type="button" disabled style="padding: 4px 12px; font-size: 0.85rem; background: #eee; border: 1px solid var(--border); border-radius: 3px; cursor: not-allowed;">MFA 有効化 (Phase 6: TOTP/passkey/SMS)</button>
      </div>

      <div style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin-bottom: 12px;">
        <h3 style="font-size: 0.95rem; margin: 0 0 8px 0;">active session ({securitySettings.activeSessions.length})</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          {securitySettings.activeSessions.map(s => (
            <li style={`padding: 8px 0; border-bottom: 1px dashed var(--border); font-size: 0.85rem; ${s.isCurrent ? 'background: #f8fcf8;' : ''}`}>
              <div>
                <strong>{s.userAgent}</strong>
                {s.isCurrent && <span style="background: var(--accent); color: #fff; padding: 1px 6px; border-radius: 3px; font-size: 0.7rem; margin-left: 6px;">現在</span>}
              </div>
              <div style="color: #666;">
                {s.geoLocationLabel} · {s.ipAddress} · 最終: {s.lastActivityAt}
              </div>
              {!s.isCurrent && (
                <button type="button" disabled style="margin-top: 4px; padding: 2px 8px; font-size: 0.75rem; background: #fff5f5; color: var(--warn); border: 1px solid var(--warn); border-radius: 3px; cursor: not-allowed;">session revoke (Phase 6)</button>
              )}
            </li>
          ))}
        </ul>
      </div>

      <div style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin-bottom: 12px;">
        <h3 style="font-size: 0.95rem; margin: 0 0 8px 0;">信頼済み device ({securitySettings.trustedDevices.length})</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          {securitySettings.trustedDevices.map(d => (
            <li style="padding: 6px 0; border-bottom: 1px dashed var(--border); font-size: 0.85rem;">
              {d.deviceName} · 最終: {d.lastSeenAt} · 有効期限: {d.trustedUntil}
            </li>
          ))}
        </ul>
      </div>

      <div style="background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px;">
        <h3 style="font-size: 0.95rem; margin: 0 0 8px 0;">login 履歴 (直近)</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          {securitySettings.recentLoginHistory.map(h => (
            <li style={`padding: 6px 0; border-bottom: 1px dashed var(--border); font-size: 0.85rem; ${!h.success ? 'color: var(--warn);' : ''}`}>
              {h.attemptedAt} · {h.geoLocationLabel} · {h.ipAddress} · {h.success ? '成功' : '失敗'}
            </li>
          ))}
        </ul>
      </div>

      <p style="font-size: 0.8rem; color: #666; margin-top: 8px;">※ session revoke / device removal / MFA setup は auth-schema.ts 連動で Phase 6 実装。 skeleton は 現状 表示のみ。 IP address は sample masked。</p>
    </section>

    <style is:global>
      .tab-btn.is-active {
        color: var(--accent);
        font-weight: bold;
        border-bottom-color: var(--accent) !important;
      }
      .tab-btn:hover {
        background: #f5f5f5;
      }
    </style>

    <script is:inline>
      (function () {
        const btns = Array.from(document.querySelectorAll('.tab-btn'));
        const panels = Array.from(document.querySelectorAll('.tab-panel'));
        btns.forEach(function (btn) {
          btn.addEventListener('click', function () {
            const tab = btn.getAttribute('data-tab');
            btns.forEach(function (b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
            panels.forEach(function (p) {
              p.style.display = p.id === 'tab-' + tab ? '' : 'none';
            });
          });
        });
      })();
    </script>
  </div>
</Base>
