---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'rei-job-board — 完全無料 求人マップ',
  description = '雑誌型 求人マップ Platform (求職者情報非収集 / Google Maps URL ベース)',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <style is:global>
      :root {
        --bg: #fafafa;
        --fg: #222;
        --accent: #2c5f8a;
        --warn: #c43;
        --border: #ddd;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Meiryo', sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.6;
      }
      header {
        padding: 12px 16px;
        background: var(--accent);
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      header h1 { margin: 0; font-size: 1.1rem; }
      header nav a { color: #fff; margin-left: 12px; text-decoration: none; font-size: 0.9rem; }
      header nav a:hover { text-decoration: underline; }
      main { padding: 0; }
      footer {
        padding: 16px;
        background: #efefef;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        color: #555;
      }
      .honest-banner {
        background: #fff4e5;
        border: 1px solid #f5c47a;
        border-radius: 4px;
        padding: 10px 12px;
        margin: 8px 16px;
        font-size: 0.85rem;
        line-height: 1.5;
      }
      .honest-banner strong { color: var(--warn); }
      a { color: var(--accent); }
    </style>
  </head>
  <body>
    <header>
      <h1>rei-job-board</h1>
      <nav>
        <a href="/">地図</a>
        <a href="/shops">店舗案内</a>
        <a href="/reviews">口コミ</a>
        <a href="/ranking">ランキング</a>
        <a href="/ranking-criteria" title="v0.8.2 景表法 対応 基準明示">基準</a>
        <a href="/post">投稿</a>
        <a href="/report">通報</a>
        <a href="/dashboard/shop" title="Phase 3 skeleton (未 login sample)">店舗 dashboard</a>
        <a href="/mypage" title="Phase 4 skeleton (未 login sample)">mypage</a>
        <a href="/messages" title="Phase 5 skeleton (未 login sample)">メッセージ</a>
        <a href="/news" title="v0.8.1 特集・お知らせ">特集</a>
        <a href="/about">このサイトについて</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="honest-banner">
        <strong>本サイトは雑誌型 (求職者情報非収集) design です。</strong>
        求職者の登録・経歴・履歴・閲覧履歴等は一切収集しません。 応募は各求人投稿者の連絡先へ直接お願いします。
        詐欺求人 / 闇バイト募集 / 受け子・出し子募集 等を見かけた場合は <a href="/report">通報窓口</a> へ。
      </div>
      <p>
        本サイトは個人運営の試行プロジェクトです。 Indeed / タウンワーク / バイトル 等の既存大手と直接競合する設計ではありません。
        Google Maps URL を参照する求人マップとして hobby scale で運営しています。
      </p>
      <p>
        © 2026 rei-job-board. MIT License. | <a href="https://github.com/fc0web/rei-job-board">GitHub</a>
      </p>
    </footer>
  </body>
</html>
